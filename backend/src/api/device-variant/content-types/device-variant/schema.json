{
  "kind": "collectionType",
  "collectionName": "device_variants",
  "info": {
    "singularName": "device-variant",
    "pluralName": "device-variants",
    "displayName": "Device Variant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "Network": {
      "type": "enumeration",
      "enum": [
        "g4",
        "g5"
      ]
    },
    "Color": {
      "type": "enumeration",
      "enum": [
        "Red",
        "Mavi",
        "Black"
      ]
    },
    "Memory": {
      "type": "enumeration",
      "enum": [
        "gb128",
        "gb256",
        "T1"
      ]
    }
  }
}
